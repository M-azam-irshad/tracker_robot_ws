<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box, principal axes aligned with link frame -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12.0}" iyz="0"
             izz="${m*(x*x+y*y)/12.0}"/>
  </xacro:macro>

  <!-- Solid cylinder whose spin axis is the link Y axis (all wheels) -->
  <xacro:macro name="y_cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*r*r/2.0}" iyz="0"
             izz="${m*(3.0*r*r+h*h)/12.0}"/>
  </xacro:macro>

  <!-- Solid cylinder whose axis is the link Z axis (masts) -->
  <xacro:macro name="z_cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*(3.0*r*r+h*h)/12.0}" iyz="0"
             izz="${m*r*r/2.0}"/>
  </xacro:macro>

  <!-- Tiny placeholder inertial for light sensor / bracket links -->
  <xacro:macro name="small_inertial" params="m:=0.05">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </xacro:macro>

</robot>
