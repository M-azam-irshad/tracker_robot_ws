<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <!-- Open sheet-metal chassis (origin = geometric centre). Collision is ONE solid box. -->
  <xacro:property name="wall" value="0.004"/>
  <link name="base_link">
    <visual> <!-- floor -->
      <origin xyz="0 0 ${-chassis_height/2 + wall/2}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${wall}"/></geometry>
      <material name="camo_green"/>
    </visual>
    <visual> <!-- front wall -->
      <origin xyz="${chassis_length/2 - wall/2} 0 0"/>
      <geometry><box size="${wall} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="camo_green"/>
    </visual>
    <visual> <!-- rear wall -->
      <origin xyz="${-chassis_length/2 + wall/2} 0 0"/>
      <geometry><box size="${wall} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="camo_green"/>
    </visual>
    <visual> <!-- left wall -->
      <origin xyz="0 ${chassis_width/2 - wall/2} 0"/>
      <geometry><box size="${chassis_length} ${wall} ${chassis_height}"/></geometry>
      <material name="camo_green"/>
    </visual>
    <visual> <!-- right wall -->
      <origin xyz="0 ${-chassis_width/2 + wall/2} 0"/>
      <geometry><box size="${chassis_length} ${wall} ${chassis_height}"/></geometry>
      <material name="camo_green"/>
    </visual>
    <visual> <!-- drive motor 1 (Motor.step: 80 mm dia x 169 mm) -->
      <origin xyz="0.07 0 ${-chassis_height/2 + wall + 0.04}" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.04" length="0.169"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <visual> <!-- drive motor 2 -->
      <origin xyz="-0.07 0 ${-chassis_height/2 + wall + 0.04}" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.04" length="0.169"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <visual> <!-- left side plate (carries sprocket + roller axles) -->
      <origin xyz="0 ${chassis_width/2 + 0.015} -0.07"/>
      <geometry><box size="0.34 0.008 0.14"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <visual> <!-- right side plate -->
      <origin xyz="0 ${-chassis_width/2 - 0.015} -0.07"/>
      <geometry><box size="0.34 0.008 0.14"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_com_z}"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </inertial>
  </link>

</robot>
